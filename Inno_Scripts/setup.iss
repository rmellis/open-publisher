  // The custom external link buttons compressed to 125px wide
  hGitHubBtn := BtnCreate(WizardForm.Handle, 280, 435, 125, 45, ExpandConstant('{tmp}\btn_github.png'), 0, False);
  BtnSetEvent(hGitHubBtn, 1, CreateCallback(@GitHubBtnClick));
  
