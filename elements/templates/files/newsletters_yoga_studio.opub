          "innerHTML": "<div contenteditable='true' spellcheck='false' style='width:100%; height:100%; box-sizing:border-box; background:#581c87; color:#ffffff; border-radius:8px; padding:20px 18px; border-top:5px solid #14b8a6; font-family:sans-serif; -webkit-print-color-adjust:exact; print-color-adjust:exact;'><div style='font-size:12px; font-weight:900; letter-spacing:2px; color:#14b8a6; text-transform:uppercase; margin-bottom:12px; border-bottom:1px solid rgba(255,255,255,0.2); padding-bottom:8px;'>★ WORKSHOPS & RETREATS</div><div style='font-size:12px; line-height:1.85; color:#f1f5f9;'>• Oct 18: 2-Hour Yin & Sound Bath<br>• Nov 01: Handstand & Arm Balances<br>• Jan 15: 200-Hr Teacher Training<br>• Mar 2027: Bali Sanctuary Retreat</div><div style='margin-top:20px; background:rgba(255,255,255,0.1); border-radius:6px; padding:12px; text-align:center;'><div style='font-size:10px; font-weight:800; letter-spacing:1.5px; color:#14b8a6;'>MEMBER PORTAL</div><div style='font-size:11px; margin-top:4px;'>Scan or visit online to RSVP for all events</div></div></div>",
