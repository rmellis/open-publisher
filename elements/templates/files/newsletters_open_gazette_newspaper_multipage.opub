          "innerHTML": "\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 336 244\" width=\"100%\" height=\"100%\" style=\"display:block; overflow:visible; user-select:none; pointer-events:none;\">\n                <rect width=\"336\" height=\"244\" fill=\"#ffffff\" rx=\"6\" ry=\"6\" />\n                <text x=\"168\" y=\"22\" text-anchor=\"middle\" font-family=\"'Segoe UI', Roboto, sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#1e293b\">Community Publication Formats</text>\n                <g class=\"chart-pie-group\">\n                    <g class=\"chart-slice\">\n                        <path d=\"M 168 47 A 72 72 0 0 1 217.2873916268656 171.48574117434163 L 194.61519147850743 147.3423002341445 A 38.88 38.88 0 0 0 168 80.12 Z\" fill=\"#0f5c57\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />\n                        <text x=\"219.54680837764465\" y=\"102.59117479916145\" text-anchor=\"middle\" font-family=\"'Segoe UI', Roboto, sans-serif\" font-size=\"11\" font-weight=\"700\" fill=\"#ffffff\" style=\"text-shadow:0 1px 2px rgba(0,0,0,0.45); pointer-events:none;\">38%</text>\n                    </g>\n                \n                    <g class=\"chart-slice\">\n                        <path d=\"M 217.2873916268656 171.48574117434163 A 72 72 0 0 1 109.75077640500379 161.32053816505808 L 136.54541925870205 141.85309060913136 A 38.88 38.88 0 0 0 194.61519147850743 147.3423002341445 Z\" fill=\"#c26d1f\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />\n                        <text x=\"162.78263510962157\" y=\"178.19395531759474\" text-anchor=\"middle\" font-family=\"'Segoe UI', Roboto, sans-serif\" font-size=\"11\" font-weight=\"700\" fill=\"#ffffff\" style=\"text-shadow:0 1px 2px rgba(0,0,0,0.45); pointer-events:none;\">27%</text>\n                    </g>\n                \n                    <g class=\"chart-slice\">\n                        <path d=\"M 109.75077640500379 161.320538165058