          "type": "shape",
          "innerHTML": "<svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"width:100%; height:100%; overflow:visible; position:absolute; top:0; left:0;\"><g class=\"shape-path\" fill=\"#cbd5e1\" stroke=\"none\" stroke-width=\"0\"><rect x=\"0\" y=\"0\" width=\"100\" height=\"100\" rx=\"0.00\" ry=\"0.00\" vector-effect=\"non-scaling-stroke\" /></g></svg>",
