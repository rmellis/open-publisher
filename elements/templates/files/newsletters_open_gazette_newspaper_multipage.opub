          "innerHTML": "\n            <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 336 244\" width=\"100%\" height=\"100%\" style=\"display:block; overflow:visible; user-select:none; pointer-events:none;\">\n                <rect width=\"336\" height=\"244\" fill=\"#ffffff\" rx=\"6\" ry=\"6\" />\n                <text x=\"168\" y=\"22\" text-anchor=\"middle\" font-family=\"'Segoe UI', Roboto, sans-serif\" font-size=\"14\" font-weight=\"700\" fill=\"#1e293b\">5-Year DTP Software Cost (USD)</text>\n                \n                <g class=\"chart-column-group\">\n                    \n                    <line x1=\"45\" y1=\"180\" x2=\"316\" y2=\"180\" stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"none\" />\n                    <text x=\"37\" y=\"183.5\" text-anchor=\"end\" font-family=\"'Segoe UI', sans-serif\" font-size=\"9.5\" fill=\"#94a3b8\">0</text>\n                \n                    <line x1=\"45\" y1=\"145.5\" x2=\"316\" y2=\"145.5\" stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"3,3\" />\n                    <text x=\"37\" y=\"149\" text-anchor=\"end\" font-family=\"'Segoe UI', sans-serif\" font-size=\"9.5\" fill=\"#94a3b8\">1984</text>\n                \n                    <line x1=\"45\" y1=\"111\" x2=\"316\" y2=\"111\" stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"3,3\" />\n                    <text x=\"37\" y=\"114.5\" text-anchor=\"end\" font-family=\"'Segoe UI', sans-serif\" font-size=\"9.5\" fill=\"#94a3b8\">3968</text>\n                \n                    <line x1=\"45\" y1=\"76.5\" x2=\"316\" y2=\"76.5\" stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"3,3\" />\n                    <text x=\"37\" y=\"80\" text-anchor=\"end\" font-family=\"'Segoe UI', sans-serif\" font-size=\"9.5\" fill=\"#94a3b8\">5951</text>\n                \n                    <line x1=\"45\" y1=\"42\" x2=\"316\" y2=\"42\" stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"3,3\" />\n                    <text x=\"37