; Script generated by Gemini, King of the forest!
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Open Publisher"
#define MyAppVersion "5"
#define MyAppPublisher "OpenPublisher"
#define MyAppURL "https://openpublisher.app/"
#define MyAppExeName "OpenPublisher.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".opub"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt
; Replace the #PATH-TO-... placeholders below with your local paths before compiling.
; Tip: installerSlides and botva2.dll are included in this folder (.\installerSlides and .).
#define SourcePath "#PATH-TO-GECKO-APP-FOLDER"
#define UIPath "#PATH-TO-INSTALLER-SLIDES"
#define WinInstallPath "#PATH-TO-BOTVA2-FOLDER"

[Setup]
AppId={{F5AF5C50-A2EC-4081-899A-0904A6169CD0}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DefaultGroupName={#MyAppName}
PrivilegesRequired=lowest
OutputDir=#PATH-TO-OUTPUT-FOLDER
OutputBaseFilename=OP_Setup
SetupIconFile={#SourcePath}\assets\branding\OpenPublisherV5.ico
SolidCompression=yes
WizardStyle=modern
DisableWelcomePage=no 
DisableDirPage=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
; =========================================================================
; CUSTOM UI ASSETS (BOTVA2, SLIDES, AND BUTTONS)
; =========================================================================
Source: "{#WinInstallPath}\botva2.dll"; Flags: dontcopy
Source: "{#UIPath}\1.png"; Flags: dontcopy
Source: "{#UIPath}\2.png"; Flags: dontcopy
Source: "{#UIPath}\3.png"; Flags: dontcopy
Source: "{#UIPath}\4.png"; Flags: dontcopy
Source: "{#UIPath}\5.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_next.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_finish.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_back_secondary.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_cancel_secondary.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_install.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_close.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_change_secondary.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_github.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_patreon.png"; Flags: dontcopy
Source: "{#UIPath}\buttons\btn_fb.png"; Flags: dontcopy

; =========================================================================
; APPLICATION FILES (GECKO EDITION)
; =========================================================================
Source: "{#SourcePath}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\gecko_nw_shim.js"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\inject.js"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\manifest.json"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\op_menu_hook.dll"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\op_native_menu.exe"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\op_tray.exe"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\reset_firstrun.flag"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\wrapper.html"; DestDir: "{app}"; Flags: ignoreversion; BeforeInstall: UpdateCurrentFileLabel

; Subdirectories
Source: "{#SourcePath}\assets\*"; DestDir: "{app}\assets"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\dictionaries\*"; DestDir: "{app}\dictionaries"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\firefox\*"; DestDir: "{app}\firefox"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\firstrun_assets\*"; DestDir: "{app}\firstrun_assets"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\fonts\*"; DestDir: "{app}\fonts"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\node_modules\*"; DestDir: "{app}\node_modules"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\profile\chrome\*"; DestDir: "{app}\profile\chrome"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel
Source: "{#SourcePath}\windows\*"; DestDir: "{app}\windows"; Flags: ignoreversion recursesubdirs createallsubdirs; BeforeInstall: UpdateCurrentFileLabel

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Check: IsAssocChecked

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Check: IsStartMenuChecked
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Check: IsDesktopShortcutChecked
Name: "{autodesktop}\Knowledge Base"; Filename: "https://kb.sloydcraft.co.uk/"; Check: IsKBChecked

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  bg1, bg2, bg3, bg4, bg5: Longint;
  hNextBtn, hFinishBtn, hBackBtn, hCancelBtn, hCloseBtn, hInstallBtn, hChangeBtn, hGitHubBtn, hPatreonBtn, hFBBtn: HWND;
  DragZone: TLabel;
  ControlPanel, SummaryPanel: TPanel;
  cbDesktop, cbStartMenu, cbKB, cbAssoc: TNewCheckBox;
  CurrentSetupPage: Integer;
  
  // Summary Slide Split Labels
  lblSumTitle: TLabel;
  lblDirArrow, lblDirTitle, lblDirVal: TLabel;
  lblCompArrow, lblCompTitle, lblCompVal: TLabel;
  lblReqArrow, lblReqText: TLabel;
  lblAvailArrow, lblAvailTitle, lblAvailVal: TLabel;
  
  // Installing Slide Custom Text & Live Progress State
  lblInstallHeader, lblInstallPct: TLabel;
  lblFileArrow, lblFileTitle: TLabel;
  lblCurrentFile: TNewStaticText;
  lblAlmostThere: TLabel;
