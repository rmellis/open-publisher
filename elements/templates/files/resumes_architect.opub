          "width": "200.0px",
          "height": "600.0px",
          "innerHTML": "<div style='font-family:\"Open Sans\", sans-serif; font-size:11px; color:#444;'><h3 style='font-family:\"Oswald\", sans-serif; font-size:16px; color:#111; letter-spacing:2px; margin-bottom:15px;'>CONTACT</h3><p style='line-height:2;'>T: +44 7700 900077<br>E: d.baumann@arch.co.uk<br>W: baumann-design.com<br>L: London, UK</p><br><br><h3 style='font-family:\"Oswald\", sans-serif; font-size:16px; color:#111; letter-spacing:2px; margin-bottom:15px;'>SOFTWARE</h3><p style='line-height:2;'>AutoCAD<br>Revit Architecture<br>Rhino 3D<br>SketchUp<br>V-Ray Rendering</p></div>",
