        {
          "id": "pub-el-gaz-2029",
          "left": "36px",
          "top": "182px",
          "width": "348px",
          "height": "194px",
          "transform": "none",
          "zIndex": "10",
          "overflow": "visible",
          "type": "text",
          "innerHTML": "<div contenteditable=\"true\" spellcheck=\"false\" style=\"width:100%; height:100%; padding:0px; box-sizing:border-box; font-family:'Merriweather', Georgia, serif; font-size:9.5px; color:#1f2937; line-height:1.44; text-align:justify; outline:none;\"><div style=\"margin:0 0 9px 0;\"><span style=\"float:left; font-family:'Playfair Display', Georgia, serif; font-size:36px; line-height:0.84; font-weight:700; color:#0f5c57; padding:3px 7px 0 0;\">T</span>eachers across neighborhood schools and libraries no longer herd student reporters around rented office suites. Instead, advisers lock global <b>Master Pages</b> once, configure <b>3-Zone Headers</b> with automatic <b>Dynamic Page Numbers</b>, and let students focus purely on journalism.</div><div style=\"margin:0;\">Shared masthead banners, school crests, and seasonal sponsor frames stay organized inside the local <b>Clipboard Scrapbook</b> for one-click drop-in reuse across every monthly issue.</div></div>",
          "imgSrc": "",
          "clipPath": "",
          "bg": "",
          "cropMode": false,
