          "innerHTML": "<div style='font-family:\"Oswald\", sans-serif; color:#111111; text-transform:uppercase;'><h1 style='font-size:54px; margin:0; line-height:1; letter-spacing:4px;'>DAVID<br>BAUMANN</h1><div style='width:60px; height:4px; background:#111111; margin:20px 0;'></div><p style='font-family:\"Open Sans\", sans-serif; font-weight:600; font-size:14px; letter-spacing:2px;'>LEAD ARCHITECT / URBAN DESIGNER</p></div>",
