          "innerHTML": "<div contenteditable=\"true\" spellcheck=\"false\" style=\"width:100%; height:100%; padding:0px; box-sizing:border-box; font-family:'Playfair Display', Georgia, serif; font-size:18px; color:#111827; line-height:1.18; text-align:left; font-weight:700; outline:none;\">Why Creative Tools Belong to Everyone, Not Monthly Subscriptions</div>",
