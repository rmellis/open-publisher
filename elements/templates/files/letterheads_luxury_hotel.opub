          "innerHTML": "<div style='background: #c9a84c; width:100%; height:100%; display:flex; align-items:center; justify-content:center;'><h1 style='font-family:\"Cinzel\", serif; color:#ffffff; margin:0; font-size:32px; font-weight:600; letter-spacing:6px;'>THE GRAND EMPRESS</h1></div>",
          "transform": "none",
