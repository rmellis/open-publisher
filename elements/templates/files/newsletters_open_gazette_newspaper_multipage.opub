        {
          "id": "pub-el-gaz-0091",
          "left": "214px",
          "top": "522px",
          "width": "298px",
          "height": "246px",
          "transform": "none",
          "zIndex": "10",
          "overflow": "visible",
          "type": "text",
          "innerHTML": "<div contenteditable=\"true\" spellcheck=\"false\" style=\"width:100%; height:100%; padding:0px; box-sizing:border-box; font-family:'Merriweather', Georgia, serif; font-size:9.7px; color:#1f2937; line-height:1.48; text-align:justify; outline:none;\"><div style=\"margin:0 0 11px 0;\">Software craftsmanship works best when it stays modest and dependable: crisp vector lines, honest page margins, fast local saves, and file formats documented in plain sight.</div><div style=\"margin:0;\">That quiet covenant is why volunteer editors from rural chapels to urban STEM classrooms treat OpenPublisher less like a startup product and more like a trusted town printing press.</div></div>",
          "imgSrc": "",
          "clipPath": "",
          "bg": "",
          "cropMode": false,
