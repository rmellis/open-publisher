          "innerHTML": "<div contenteditable='true' spellcheck='false' style='width:100%; height:100%; box-sizing:border-box; background:#f8fafc; border-left:4px solid #991b1b; padding:12px 18px; font-family:sans-serif; font-size:13.5px; font-weight:800; color:#0f172a; letter-spacing:0.3px; -webkit-print-color-adjust:exact; print-color-adjust:exact;'>RE: Strategic Joint Venture & Series C Institutional Commitment</div>",
          "transform": "none",
