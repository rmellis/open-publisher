          "innerHTML": "<div contenteditable='true' spellcheck='false' style='font-family:sans-serif; border-bottom:3px solid #09090b; padding-bottom:16px; -webkit-print-color-adjust:exact; print-color-adjust:exact;'><div style='font-size:32px; font-weight:900; color:#09090b; letter-spacing:1.5px; line-height:1.1;'>KAI TAKAHASHI</div><div style='font-size:12.5px; font-weight:800; letter-spacing:2.5px; color:#a855f7; margin-top:8px; background:#09090b; display:inline-block; padding:5px 12px; border-radius:4px; -webkit-print-color-adjust:exact; print-color-adjust:exact;'>CREATIVE TECHNOLOGIST & XR PRODUCT ARCHITECT</div></div>",
