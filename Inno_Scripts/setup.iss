  BtnSetEvent(hYWABtn, 1, CreateCallback(@YWABtnClick));

  hCloseBtn := BtnCreate(WizardForm.Handle, 860, 10, 30, 30, ExpandConstant('{tmp}\btn_close.png'), 0, False);
  BtnSetEvent(hCloseBtn, 1, CreateCallback(@CloseBtnClick));

  ImgApplyChanges(WizardForm.Handle);
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  if (PageID = wpSelectProgramGroup) or (PageID = wpSelectTasks) then
    Result := True
  else
    Result := False;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  comps: String;
  FreeMB, TotalMB: Cardinal;
begin
  CurrentSetupPage := CurPageID;
  if WizardSilent then Exit; 

  WizardForm.NextButton.Left := 3000;
  WizardForm.BackButton.Left := 3000;
  WizardForm.CancelButton.Left := 3000;

  ImgSetVisibility(bg1, False);
  ImgSetVisibility(bg2, False);
  ImgSetVisibility(bg3, False);
  ImgSetVisibility(bg4, False);
  ImgSetVisibility(bg5, False);
  
  BtnSetVisibility(hNextBtn, False);
  BtnSetVisibility(hFinishBtn, False);
  BtnSetVisibility(hInstallBtn, False);
  BtnSetVisibility(hChangeBtn, False);
  BtnSetVisibility(hBackBtn, True); 
  BtnSetVisibility(hCancelBtn, True); 
  BtnSetVisibility(hGitHubBtn, False);
  BtnSetVisibility(hPatreonBtn, False);
  BtnSetVisibility(hYWABtn, False);
  
  ControlPanel.Hide;
  SummaryPanel.Hide;
  WizardForm.DirEdit.Hide;
  WizardForm.ProgressGauge.Hide;
  WizardForm.StatusLabel.Hide;
  WizardForm.FilenameLabel.Hide;
  cbDesktop.Hide;
  cbStartMenu.Hide;
  cbKB.Hide;
  cbAssoc.Hide;
  lblAlmostThere.Hide;
  
  case CurPageID of
    wpWelcome: 
      begin
        ImgSetVisibility(bg1, True);
        BtnSetVisibility(hNextBtn, True);
        BtnSetVisibility(hBackBtn, False); 
      end;
    wpSelectDir: 
      begin
        ImgSetVisibility(bg2, True);
        BtnSetVisibility(hNextBtn, True);
        BtnSetVisibility(hChangeBtn, True); 
        ControlPanel.Width := 310; 
        ControlPanel.Show;
        WizardForm.DirEdit.Show;
        cbDesktop.Show;
        cbStartMenu.Show;
        cbKB.Show;
        cbAssoc.Show;
      end;
    wpReady: 
      begin
        ImgSetVisibility(bg3, True);
        BtnSetVisibility(hInstallBtn, True); 
        
        lblDirVal.Caption := ' ' + WizardForm.DirEdit.Text;
        lblDirVal.Left := lblDirTitle.Left + lblDirTitle.Width;
        
        comps := '';
        if cbDesktop.Checked then comps := comps + '- Desktop Shortcut: Enabled' + #13#10;
        if cbStartMenu.Checked then comps := comps + '- Start Menu Shortcut: Enabled' + #13#10;
        if cbKB.Checked then comps := comps + '- Knowledge Base Link: Enabled' + #13#10;
        if cbAssoc.Checked then comps := comps + '- Associate .opub: Enabled' + #13#10;
        
        lblCompVal.Caption := comps;
        
        lblReqArrow.Top := lblCompVal.Top + lblCompVal.Height + 2;
        lblReqText.Top := lblReqArrow.Top;
        lblReqText.Caption := WizardForm.DiskSpaceLabel.Caption; 
        
        lblAvailArrow.Top := lblReqArrow.Top + 16;
        lblAvailTitle.Top := lblAvailArrow.Top;
        lblAvailVal.Top := lblAvailArrow.Top;
        
        if GetSpaceOnDisk(ExtractFileDrive(WizardForm.DirEdit.Text), True, FreeMB, TotalMB) then
        begin
          if FreeMB >= 1024 then
            lblAvailVal.Caption := ' ' + IntToStr(FreeMB div 1024) + ' GB'
          else
            lblAvailVal.Caption := ' ' + IntToStr(FreeMB) + ' MB';
        end else begin
          lblAvailVal.Caption := ' Unknown';
        end;
        
        lblAvailVal.Left := lblAvailTitle.Left + lblAvailTitle.Width;

        if cbKB.Checked then
        begin
          lblAvailArrow.Visible := False;
          lblAvailTitle.Visible := False;
          lblAvailVal.Visible := False;
        end
        else
        begin
          lblAvailArrow.Visible := True;
          lblAvailTitle.Visible := True;
          lblAvailVal.Visible := True;
        end;
        
        SummaryPanel.Show;
      end;
    wpInstalling: 
      begin
        ImgSetVisibility(bg4, True);
        BtnSetVisibility(hBackBtn, False); 
        BtnSetVisibility(hCancelBtn, True); 
        ControlPanel.Width := 580; 
        ControlPanel.Show;
        
        WizardForm.ProgressGauge.Width := 580;
        WizardForm.ProgressGauge.Height := 12;
        WizardForm.ProgressGauge.Show;      
        
        WizardForm.StatusLabel.Width := 580;
        WizardForm.StatusLabel.Show;
        
        WizardForm.FilenameLabel.Width := 580;
        WizardForm.FilenameLabel.Show;

        lblAlmostThere.Show;
      end;
    wpInfoAfter, wpFinished: 
      begin
        ImgSetVisibility(bg5, True);
        BtnSetVisibility(hFinishBtn, True); 
        BtnSetVisibility(hBackBtn, False); 
        BtnSetVisibility(hCancelBtn, False); 
        BtnSetVisibility(hGitHubBtn, True); 
        BtnSetVisibility(hPatreonBtn, True); 
        BtnSetVisibility(hYWABtn, True); 
      end;
  else
    begin
      ImgSetVisibility(bg2, True); 
      BtnSetVisibility(hNextBtn, True);
    end;
  end;
  
  ImgApplyChanges(WizardForm.Handle);
end;

procedure DeinitializeSetup();
begin
  if not WizardSilent then
    gdipShutdown;
end;