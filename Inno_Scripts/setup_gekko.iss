  lblCompVal.Font.Height := -11;
  lblCompVal.AutoSize := True;
  lblCompVal.WordWrap := False;

  lblReqArrow := TLabel.Create(WizardForm);
  lblReqArrow.Parent := SummaryPanel;
  lblReqArrow.Left := 0;
  lblReqArrow.Font.Name := 'Segoe UI';
  lblReqArrow.Font.Height := -11;
  lblReqArrow.Font.Style := [fsBold];
  lblReqArrow.Font.Color := $5B6916;
  lblReqArrow.Caption := '>';

  lblReqText := TLabel.Create(WizardForm);
  lblReqText.Parent := SummaryPanel;
  lblReqText.Left := 15;
  lblReqText.Font.Name := 'Segoe UI';
  lblReqText.Font.Height := -11;
  lblReqText.AutoSize := True;

  lblAvailArrow := TLabel.Create(WizardForm);
  lblAvailArrow.Parent := SummaryPanel;
  lblAvailArrow.Left := 0;
  lblAvailArrow.Font.Name := 'Segoe UI';
  lblAvailArrow.Font.Height := -11;
  lblAvailArrow.Font.Style := [fsBold];
  lblAvailArrow.Font.Color := $5B6916;
  lblAvailArrow.Caption := '>';

  lblAvailTitle := TLabel.Create(WizardForm);
  lblAvailTitle.Parent := SummaryPanel;
  lblAvailTitle.Left := 15;
  lblAvailTitle.Font.Name := 'Segoe UI';
  lblAvailTitle.Font.Height := -11;
  lblAvailTitle.Font.Style := [fsBold];
  lblAvailTitle.AutoSize := True;
  lblAvailTitle.Caption := 'Disk Space Available:';

  lblAvailVal := TLabel.Create(WizardForm);
  lblAvailVal.Parent := SummaryPanel;
  lblAvailVal.Font.Name := 'Segoe UI';
  lblAvailVal.Font.Height := -11;
  lblAvailVal.AutoSize := True;
  // =========================================================================

  bg1 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\1.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg2 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\2.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg3 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\3.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg4 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\4.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg5 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\5.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  
  hNextBtn := BtnCreate(WizardForm.Handle, 750, 435, 100, 35, ExpandConstant('{tmp}\btn_next.png'), 0, False);
  BtnSetEvent(hNextBtn, 1, CreateCallback(@NextBtnClick));
  
  // Custom Finish button (larger and right-aligned)
  hFinishBtn := BtnCreate(WizardForm.Handle, 690, 435, 160, 45, ExpandConstant('{tmp}\btn_finish.png'), 0, False);
  BtnSetEvent(hFinishBtn, 1, CreateCallback(@NextBtnClick));

  hInstallBtn := BtnCreate(WizardForm.Handle, 750, 435, 100, 35, ExpandConstant('{tmp}\btn_install.png'), 0, False);
  BtnSetEvent(hInstallBtn, 1, CreateCallback(@InstallBtnClick));

  hBackBtn := BtnCreate(WizardForm.Handle, 640, 435, 100, 35, ExpandConstant('{tmp}\btn_back_secondary.png'), 0, False);
  BtnSetEvent(hBackBtn, 1, CreateCallback(@BackBtnClick));

  hCancelBtn := BtnCreate(WizardForm.Handle, 280, 435, 100, 35, ExpandConstant('{tmp}\btn_cancel_secondary.png'), 0, False);
  BtnSetEvent(hCancelBtn, 1, CreateCallback(@CancelBtnClick));

  hChangeBtn := BtnCreate(WizardForm.Handle, 590, 288, 100, 35, ExpandConstant('{tmp}\btn_change_secondary.png'), 0, False);
  BtnSetEvent(hChangeBtn, 1, CreateCallback(@ChangeBtnClick));

  // The custom external link buttons compressed to 125px wide
  hGitHubBtn := BtnCreate(WizardForm.Handle, 280, 435, 125, 45, ExpandConstant('{tmp}\btn_github.png'), 0, False);
  BtnSetEvent(hGitHubBtn, 1, CreateCallback(@GitHubBtnClick));
  
  hPatreonBtn := BtnCreate(WizardForm.Handle, 415, 435, 125, 45, ExpandConstant('{tmp}\btn_patreon.png'), 0, False);
  BtnSetEvent(hPatreonBtn, 1, CreateCallback(@PatreonBtnClick));

  hFBBtn := BtnCreate(WizardForm.Handle, 550, 435, 125, 45, ExpandConstant('{tmp}\btn_fb.png'), 0, False);
  BtnSetEvent(hFBBtn, 1, CreateCallback(@FBBtnClick));

  hCloseBtn := BtnCreate(WizardForm.Handle, 860, 10, 30, 30, ExpandConstant('{tmp}\btn_close.png'), 0, False);
  BtnSetEvent(hCloseBtn, 1, CreateCallback(@CloseBtnClick));

  ImgApplyChanges(WizardForm.Handle);
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  if (PageID = wpSelectProgramGroup) or (PageID = wpSelectTasks) then
    Result := True
  else
    Result := False;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  comps: String;
  FreeMB, TotalMB: Cardinal;
begin
  CurrentSetupPage := CurPageID;
  if WizardSilent then Exit; 

  if ProgressTimerActive and (CurPageID <> wpInstalling) then
  begin
    KillTimer(WizardForm.Handle, 101);
    ProgressTimerActive := False;
  end;

  WizardForm.NextButton.Left := 3000;
  WizardForm.BackButton.Left := 3000;
  WizardForm.CancelButton.Left := 3000;

  ImgSetVisibility(bg1, False);
  ImgSetVisibility(bg2, False);
  ImgSetVisibility(bg3, False);
  ImgSetVisibility(bg4, False);
  ImgSetVisibility(bg5, False);
  
  BtnSetVisibility(hNextBtn, False);
  BtnSetVisibility(hFinishBtn, False);
  BtnSetVisibility(hInstallBtn, False);
  BtnSetVisibility(hChangeBtn, False);
  BtnSetVisibility(hBackBtn, True); 
  BtnSetVisibility(hCancelBtn, True); 
  BtnSetVisibility(hGitHubBtn, False);
  BtnSetVisibility(hPatreonBtn, False);
  BtnSetVisibility(hFBBtn, False);
  
  ControlPanel.Hide;
  SummaryPanel.Hide;
  WizardForm.DirEdit.Hide;
  WizardForm.ProgressGauge.Hide;
  WizardForm.StatusLabel.Hide;
  WizardForm.FilenameLabel.Hide;
  lblInstallHeader.Hide;
  lblInstallPct.Hide;
  lblFileArrow.Hide;
  lblFileTitle.Hide;
  lblCurrentFile.Hide;
  cbDesktop.Hide;
  cbStartMenu.Hide;
  cbKB.Hide;
  cbAssoc.Hide;
  lblAlmostThere.Hide;
  
  case CurPageID of
    wpWelcome: 
      begin
        ImgSetVisibility(bg1, True);
        BtnSetVisibility(hNextBtn, True);
        BtnSetVisibility(hBackBtn, False); 
      end;
    wpSelectDir: 
      begin
        ImgSetVisibility(bg2, True);
        BtnSetVisibility(hNextBtn, True);
        BtnSetVisibility(hChangeBtn, True); 
        ControlPanel.Width := 310; 
        ControlPanel.Show;
        WizardForm.DirEdit.Show;
        cbDesktop.Show;
        cbStartMenu.Show;
        cbKB.Show;
        cbAssoc.Show;
      end;
    wpReady: 
      begin
        ImgSetVisibility(bg3, True);
        BtnSetVisibility(hInstallBtn, True); 
        
        lblDirVal.Caption := ' ' + WizardForm.DirEdit.Text;
        lblDirVal.Left := lblDirTitle.Left + lblDirTitle.Width;
        
        comps := '';
        if cbDesktop.Checked then comps := comps + '- Desktop Shortcut: Enabled' + #13#10;
        if cbStartMenu.Checked then comps := comps + '- Start Menu Shortcut: Enabled' + #13#10;
        if cbKB.Checked then comps := comps + '- Knowledge Base Link: Enabled' + #13#10;
        if cbAssoc.Checked then comps := comps + '- Associate .opub: Enabled' + #13#10;
        
        lblCompVal.Caption := comps;
        
        lblReqArrow.Top := lblCompVal.Top + lblCompVal.Height + 2;
        lblReqText.Top := lblReqArrow.Top;
        lblReqText.Caption := WizardForm.DiskSpaceLabel.Caption; 
        
        lblAvailArrow.Top := lblReqArrow.Top + 16;
        lblAvailTitle.Top := lblAvailArrow.Top;
        lblAvailVal.Top := lblAvailArrow.Top;
        
        if GetSpaceOnDisk(ExtractFileDrive(WizardForm.DirEdit.Text), True, FreeMB, TotalMB) then
        begin
          if FreeMB >= 1024 then
            lblAvailVal.Caption := ' ' + IntToStr(FreeMB div 1024) + ' GB'
          else
            lblAvailVal.Caption := ' ' + IntToStr(FreeMB) + ' MB';
        end else begin
          lblAvailVal.Caption := ' Unknown';
        end;
        
        lblAvailVal.Left := lblAvailTitle.Left + lblAvailTitle.Width;

        if cbKB.Checked then
        begin
          lblAvailArrow.Visible := False;
          lblAvailTitle.Visible := False;
          lblAvailVal.Visible := False;
        end
        else
        begin
          lblAvailArrow.Visible := True;
          lblAvailTitle.Visible := True;
          lblAvailVal.Visible := True;
        end;
        
        SummaryPanel.Show;
      end;
    wpInstalling: 
      begin
        ImgSetVisibility(bg4, True);
        BtnSetVisibility(hBackBtn, False); 
        BtnSetVisibility(hCancelBtn, True); 
        ControlPanel.Width := 580; 
        ControlPanel.Show;
        
        WizardForm.ProgressGauge.Width := 580;
        WizardForm.ProgressGauge.Height := 12;
        WizardForm.ProgressGauge.Show;      
        
        WizardForm.StatusLabel.Hide;
        WizardForm.FilenameLabel.Hide;

        lblInstallHeader.Show;
        lblFileArrow.Show;
        lblFileTitle.Show;

        lblCurrentFile.Left := lblFileTitle.Left + lblFileTitle.Width + 8;
        lblCurrentFile.Width := 435 - lblCurrentFile.Left;
        lblCurrentFile.Show;

        lblInstallPct.Show;
        lblAlmostThere.Show;

        if not ProgressTimerActive then
        begin
          SetTimer(WizardForm.Handle, 101, 40, CreateCallback(@ProgressTimerProc));
          ProgressTimerActive := True;
        end;
      end;
    wpInfoAfter, wpFinished: 
      begin
        ImgSetVisibility(bg5, True);
        BtnSetVisibility(hFinishBtn, True); 
        BtnSetVisibility(hBackBtn, False); 
        BtnSetVisibility(hCancelBtn, False); 
        BtnSetVisibility(hGitHubBtn, True); 
        BtnSetVisibility(hPatreonBtn, True); 
        BtnSetVisibility(hFBBtn, True); 
      end;
  else
    begin
      ImgSetVisibility(bg2, True); 
      BtnSetVisibility(hNextBtn, True);
    end;
  end;
  
  ImgApplyChanges(WizardForm.Handle);
end;

procedure DeinitializeSetup();
begin
  if not WizardSilent then
  begin
    if ProgressTimerActive then
    begin
      KillTimer(WizardForm.Handle, 101);
      ProgressTimerActive := False;
    end;
    gdipShutdown;
  end;
end;