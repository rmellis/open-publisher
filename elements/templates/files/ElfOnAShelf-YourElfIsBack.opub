          "innerHTML": "<div style=\"color: rgb(0, 0, 0); padding: 10px; height: 100%; overflow-wrap: break-word; outline: none; font-family: &quot;Segoe UI&quot;, Tahoma, Arial, &quot;Noto Sans Arabic&quot;, Amiri, sans-serif; cursor: url(&quot;ui/icons/truck.svg&quot;) 11 11, move; box-sizing: border-box; pointer-events: auto;\" contenteditable=\"true\" spellcheck=\"false\" lang=\"en-GB\" dir=\"auto\"><div style=\"text-align: center;\"><span style=\"font-family: &quot;Patrick Hand&quot;; font-weight: bold;\"><font style=\"font-size: 51px;\">DEAR SMALL HUMAN,</font></span></div></div>",
