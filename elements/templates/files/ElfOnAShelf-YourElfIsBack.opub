        {
          "id": "pub-el-0qulqt02r",
          "left": "125.915px",
          "top": "486.651px",
          "width": "552px",
          "height": "548px",
          "transform": "none",
          "zIndex": "10",
          "overflow": "",
          "type": "box",
          "innerHTML": "<div style=\"color: rgb(44, 62, 80); padding: 10px; height: 100%; overflow-wrap: break-word; outline: none; font-family: &quot;Segoe UI&quot;, Tahoma, Arial, &quot;Noto Sans Arabic&quot;, Amiri, sans-serif; cursor: text; box-sizing: border-box; pointer-events: auto;\" contenteditable=\"true\" spellcheck=\"false\" lang=\"en-GB\" dir=\"auto\"><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">Hello my little friend, guess who's here?</font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">It's your magical elf, full of cheer!</font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\"><br></font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">I'll be watching for kindness and glee,</font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">to tell santa about all that I see.</font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\"><br></font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">Be good, be sweet, and you will find,</font></div><div style=\"text-align: center;\"><font style=\"font-family: &quot;Patrick Hand&quot;; font-size: 32px;\">Christmas magic of the best kind.<br><br>Let;s make this season merry and bright,</font></div><div style=\"text-align: center;\"><font face=\"Patrick Hand\" style=\"font-size: 32px;\">with love from your elf, starting tonight!</font></div></div>",
          "imgSrc": "",
          "clipPath": "",
          "bg": "",
          "cropMode": false,
          "imgStyle": {},
          "scaleX": "1",
          "scaleY": "1",
          "shrinkOverflow": false,
