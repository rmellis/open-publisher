        {
          "id": "pub-el-gaz-0045",
          "left": "36px",
          "top": "532px",
          "width": "224px",
          "height": "510px",
          "transform": "none",
          "zIndex": "10",
          "overflow": "visible",
          "type": "text",
          "innerHTML": "<div contenteditable=\"true\" spellcheck=\"false\" style=\"width:100%; height:100%; padding:0px; box-sizing:border-box; font-family:'Merriweather', Georgia, serif; font-size:9.6px; color:#1f2937; line-height:1.46; text-align:justify; outline:none;\"><div style=\"margin:0 0 11px 0;\"><span style=\"float:left; font-family:'Playfair Display', Georgia, serif; font-size:36px; line-height:0.84; font-weight:700; color:#0f5c57; padding:3px 7px 0 0;\">M</span>aster Pages act as an architectural steel frame beneath multi-page print jobs. Editors type the left publication slug, center edition label, and right page-number token once, while automatic Page 1 suppression keeps the front page clean.</div><div style=\"margin:0 0 11px 0;\">Toggling Spreads Mode pairs facing sheets cleanly while isolating Master Page objects from Page 1 content, ensuring per-page headers and decorative antique borders remain confined strictly to each half of a booklet fold.</div><div style=\"margin:0;\"><b>Native .OPUB Architecture:</b> Every project saves cleanly as a self-contained JSON-backed package with embedded assets, ready for offline archival.</div></div>",
          "imgSrc": "",
          "clipPath": "",
          "bg": "",
          "cropMode": false,
          "imgStyle": {},
          "scaleX": "1",
          "scaleY": "1",
          "shrinkOverflow": false,
