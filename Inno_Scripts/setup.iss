Source: "{#SourcePath}\swiftshader\*"; DestDir: "{app}\swiftshader"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
Source: "{#SourcePath}\update_logs\*"; DestDir: "{app}\update_logs"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#SourcePath}\windows\*"; DestDir: "{app}\windows"; Flags: ignoreversion recursesubdirs createallsubdirs

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"; Check: IsAssocChecked
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Check: IsAssocChecked

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Check: IsStartMenuChecked
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Check: IsDesktopShortcutChecked
Name: "{autodesktop}\Knowledge Base"; Filename: "https://kb.sloydcraft.co.uk/"; Check: IsKBChecked

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  bg1, bg2, bg3, bg4, bg5: Longint;
  hNextBtn, hFinishBtn, hBackBtn, hCancelBtn, hCloseBtn, hInstallBtn, hChangeBtn, hGitHubBtn, hPatreonBtn, hYWABtn: HWND;
  DragZone: TLabel;
  ControlPanel, SummaryPanel: TPanel;
  cbDesktop, cbStartMenu, cbKB, cbAssoc: TNewCheckBox;
  CurrentSetupPage: Integer;
  
  // Summary Slide Split Labels
  lblSumTitle: TLabel;
  lblDirArrow, lblDirTitle, lblDirVal: TLabel;
  lblCompArrow, lblCompTitle, lblCompVal: TLabel;
  lblReqArrow, lblReqText: TLabel;
  lblAvailArrow, lblAvailTitle, lblAvailVal: TLabel;
  
  // Installing Slide Custom Text
  lblAlmostThere: TLabel;

// Windows API for Window Shaping and Dragging
function CreateRoundRectRgn(nLeftRect, nTopRect, nRightRect, nBottomRect, nWidthEllipse, nHeightEllipse: Integer): Longint; external 'CreateRoundRectRgn@gdi32.dll stdcall';
function SetWindowRgn(hWnd: HWND; hRgn: Longint; bRedraw: Boolean): Longint; external 'SetWindowRgn@user32.dll stdcall';
procedure ReleaseCapture; external 'ReleaseCapture@user32.dll stdcall';
function SendMessage(hWnd: HWND; Msg: Integer; wParam: Integer; lParam: Integer): Integer; external 'SendMessageW@user32.dll stdcall';

// Botva2 Core Graphics Functions
procedure gdipShutdown; external 'gdipShutdown@{tmp}\botva2.dll stdcall delayload';
function ImgLoad(Wnd: HWND; FileName: AnsiString; Left, Top, Width, Height: Integer; Stretch, IsBkg: Boolean): Longint; external 'ImgLoad@{tmp}\botva2.dll stdcall delayload';
procedure ImgSetVisibility(h: Longint; Visible: Boolean); external 'ImgSetVisibility@{tmp}\botva2.dll stdcall delayload';
procedure ImgApplyChanges(h: HWND); external 'ImgApplyChanges@{tmp}\botva2.dll stdcall delayload';

// Botva2 Button Functions
function BtnCreate(hParent: HWND; Left, Top, Width, Height: Integer; FileName: AnsiString; ShadowWidth: Integer; IsCheckBtn: Boolean): HWND; external 'BtnCreate@{tmp}\botva2.dll stdcall delayload';
procedure BtnSetEvent(h: HWND; EventID: Integer; Event: Longword); external 'BtnSetEvent@{tmp}\botva2.dll stdcall delayload';
procedure BtnSetVisibility(h: HWND; Value: Boolean); external 'BtnSetVisibility@{tmp}\botva2.dll stdcall delayload';

// =========================================================================
// CHECKBOX VERIFICATION FUNCTIONS
// =========================================================================
function IsDesktopShortcutChecked(): Boolean;
begin
  Result := cbDesktop.Checked;
end;

function IsStartMenuChecked(): Boolean;
begin
  Result := cbStartMenu.Checked;
end;

function IsKBChecked(): Boolean;
begin
  Result := cbKB.Checked;
end;

function IsAssocChecked(): Boolean;
begin
  Result := cbAssoc.Checked;
end;

// Enable Dragging via the Invisible Label
procedure FormMouseDown(Sender: TObject; Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
begin
  if Button = mbLeft then
  begin
    ReleaseCapture;
    SendMessage(WizardForm.Handle, $0112, $F012, 0);
  end;
end;

// Button Click Callbacks
procedure NextBtnClick(hBtn: HWND);
begin
  WizardForm.NextButton.OnClick(WizardForm.NextButton);
end;

procedure BackBtnClick(hBtn: HWND);
begin
  WizardForm.BackButton.OnClick(WizardForm.BackButton);
end;

procedure CancelBtnClick(hBtn: HWND);
begin
  WizardForm.Close;
end;

procedure InstallBtnClick(hBtn: HWND);
begin
  WizardForm.NextButton.OnClick(WizardForm.NextButton);
end;

procedure ChangeBtnClick(hBtn: HWND);
begin
  WizardForm.DirBrowseButton.OnClick(WizardForm.DirBrowseButton);
end;

procedure CloseBtnClick(hBtn: HWND);
begin
  if CurrentSetupPage = wpFinished then
    WizardForm.NextButton.OnClick(WizardForm.NextButton)
  else
    WizardForm.Close;
end;

procedure GitHubBtnClick(hBtn: HWND);
var
  ErrorCode: Integer;
begin
  ShellExec('open', 'https://github.com/rmellis/open-publisher', '', '', SW_SHOWNORMAL, ewNoWait, ErrorCode);
end;

procedure PatreonBtnClick(hBtn: HWND);
var
  ErrorCode: Integer;
begin
  ShellExec('open', 'https://www.patreon.com/cw/OpenPublisher', '', '', SW_SHOWNORMAL, ewNoWait, ErrorCode);
end;

procedure YWABtnClick(hBtn: HWND);
var
  ErrorCode: Integer;
begin
  ShellExec('open', 'https://ywa.app', '', '', SW_SHOWNORMAL, ewNoWait, ErrorCode);
end;

function InitializeSetup(): Boolean;
begin
  if WizardSilent then
  begin
    Result := True;
    Exit; 
  end;

  ExtractTemporaryFile('botva2.dll');
  ExtractTemporaryFile('1.png');
  ExtractTemporaryFile('2.png');
  ExtractTemporaryFile('3.png');
  ExtractTemporaryFile('4.png');
  ExtractTemporaryFile('5.png');
  
  ExtractTemporaryFile('btn_next.png');
  ExtractTemporaryFile('btn_finish.png');
  ExtractTemporaryFile('btn_back_secondary.png');
  ExtractTemporaryFile('btn_cancel_secondary.png');
  ExtractTemporaryFile('btn_install.png');
  ExtractTemporaryFile('btn_change_secondary.png');
  ExtractTemporaryFile('btn_close.png');
  ExtractTemporaryFile('btn_github.png');
  ExtractTemporaryFile('btn_patreon.png');
  ExtractTemporaryFile('btn_ywa.png');
  
  Result := True;
end;

procedure InitializeWizard();
begin
  if WizardSilent then Exit; 

  WizardForm.BorderStyle := bsNone;
  WizardForm.ClientWidth := 900; 
  WizardForm.ClientHeight := 494;

  SetWindowRgn(WizardForm.Handle, CreateRoundRectRgn(0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, 35, 35), True);

  WizardForm.OuterNotebook.Hide;
  WizardForm.InnerNotebook.Hide;
  WizardForm.Bevel.Hide;

  DragZone := TLabel.Create(WizardForm);
  DragZone.Parent := WizardForm;
  DragZone.Left := 0;
  DragZone.Top := 0;
  DragZone.Width := 850; 
  DragZone.Height := 60;
  DragZone.Transparent := True;
  DragZone.Caption := '';
  DragZone.OnMouseDown := @FormMouseDown;

  ControlPanel := TPanel.Create(WizardForm);
  ControlPanel.Parent := WizardForm;
  ControlPanel.Left := 280;
  ControlPanel.Top := 295; 
  ControlPanel.Width := 310; 
  ControlPanel.Height := 140;
  ControlPanel.BevelOuter := bvNone;
  ControlPanel.ParentBackground := False; 
  ControlPanel.Color := $EAEBE1; 

  WizardForm.ProgressGauge.Parent := ControlPanel;
  WizardForm.ProgressGauge.Left := 0;  
  WizardForm.ProgressGauge.Top := 15;   
  WizardForm.ProgressGauge.Width := 580; 
  WizardForm.ProgressGauge.Height := 12; 

  WizardForm.StatusLabel.Parent := ControlPanel;
  WizardForm.StatusLabel.Left := 0;
  WizardForm.StatusLabel.Top := 40;
  WizardForm.StatusLabel.Width := 580;
  WizardForm.StatusLabel.Font.Name := 'Consolas';
  WizardForm.StatusLabel.Font.Style := [fsBold];

  WizardForm.FilenameLabel.Parent := ControlPanel;
  WizardForm.FilenameLabel.Left := 0;
  WizardForm.FilenameLabel.Top := 60;
  WizardForm.FilenameLabel.Width := 580;
  WizardForm.FilenameLabel.Font.Name := 'Consolas';

  lblAlmostThere := TLabel.Create(WizardForm);
  lblAlmostThere.Parent := ControlPanel;
  lblAlmostThere.Left := 0;
  lblAlmostThere.Top := 95;
  lblAlmostThere.Font.Name := 'Segoe UI';
  lblAlmostThere.Font.Size := 11;
  lblAlmostThere.Font.Style := [fsBold];
  lblAlmostThere.Font.Color := $888888; 
  lblAlmostThere.Caption := #$2714 + ' Almost there! Final steps are underway.';

  WizardForm.DirEdit.Parent := ControlPanel;
  WizardForm.DirEdit.Left := 0;   
  WizardForm.DirEdit.Top := 0;    
  WizardForm.DirEdit.Width := 300;  

  cbDesktop := TNewCheckBox.Create(WizardForm);
  cbDesktop.Parent := ControlPanel;
  cbDesktop.Left := 0;
  cbDesktop.Top := 40;
  cbDesktop.Width := 300;
  cbDesktop.Caption := 'Create Desktop Shortcut';
  cbDesktop.Color := $EAEBE1; 
  cbDesktop.Checked := True; 

  cbStartMenu := TNewCheckBox.Create(WizardForm);
  cbStartMenu.Parent := ControlPanel;
  cbStartMenu.Left := 0;
  cbStartMenu.Top := 65;
  cbStartMenu.Width := 300;
  cbStartMenu.Caption := 'Add start menu shortcuts';
  cbStartMenu.Color := $EAEBE1; 
  cbStartMenu.Checked := True; 

  cbKB := TNewCheckBox.Create(WizardForm);
  cbKB.Parent := ControlPanel;
  cbKB.Left := 0;
  cbKB.Top := 90;
  cbKB.Width := 300;
  cbKB.Caption := 'Create link to the Knowledge Base';
  cbKB.Color := $EAEBE1; 
  cbKB.Checked := False; 

  cbAssoc := TNewCheckBox.Create(WizardForm);
  cbAssoc.Parent := ControlPanel;
  cbAssoc.Left := 0;
  cbAssoc.Top := 115;
  cbAssoc.Width := 300;
  cbAssoc.Caption := 'Associate .opub';
  cbAssoc.Color := $EAEBE1; 
  cbAssoc.Checked := True; 

  // =========================================================================
  // DYNAMIC SUMMARY PANEL CREATION
  // =========================================================================
  SummaryPanel := TPanel.Create(WizardForm);
  SummaryPanel.Parent := WizardForm;
  SummaryPanel.Left := 280;
  SummaryPanel.Top := 290; 
  SummaryPanel.Width := 420; 
  SummaryPanel.Height := 143; 
  SummaryPanel.BevelOuter := bvNone;
  SummaryPanel.ParentBackground := False; 
  SummaryPanel.Color := $EAEBE1; 

  lblSumTitle := TLabel.Create(WizardForm);
  lblSumTitle.Parent := SummaryPanel;
  lblSumTitle.Left := 0;
  lblSumTitle.Top := 0;
  lblSumTitle.Font.Name := 'Segoe UI';
  lblSumTitle.Font.Size := 10;
  lblSumTitle.Font.Style := [fsBold];
  lblSumTitle.Font.Color := $648E75; 
  lblSumTitle.Caption := 'Installation Summary';

  lblDirArrow := TLabel.Create(WizardForm);
  lblDirArrow.Parent := SummaryPanel;
  lblDirArrow.Left := 0;
  lblDirArrow.Top := 18;
  lblDirArrow.Font.Name := 'Segoe UI';
  lblDirArrow.Font.Style := [fsBold];
  lblDirArrow.Font.Color := $648E75;
  lblDirArrow.Caption := '>'; 

  lblDirTitle := TLabel.Create(WizardForm);
  lblDirTitle.Parent := SummaryPanel;
  lblDirTitle.Left := 15;
  lblDirTitle.Top := 18;
  lblDirTitle.Font.Name := 'Segoe UI';
  lblDirTitle.Font.Style := [fsBold];
  lblDirTitle.AutoSize := True;
  lblDirTitle.Caption := 'Destination:';

  lblDirVal := TLabel.Create(WizardForm);
  lblDirVal.Parent := SummaryPanel;
  lblDirVal.Top := 18;
  lblDirVal.Font.Name := 'Segoe UI';
  lblDirVal.AutoSize := True;

  lblCompArrow := TLabel.Create(WizardForm);
  lblCompArrow.Parent := SummaryPanel;
  lblCompArrow.Left := 0;
  lblCompArrow.Top := 34;
  lblCompArrow.Font.Name := 'Segoe UI';
  lblCompArrow.Font.Style := [fsBold];
  lblCompArrow.Font.Color := $648E75;
  lblCompArrow.Caption := '>';

  lblCompTitle := TLabel.Create(WizardForm);
  lblCompTitle.Parent := SummaryPanel;
  lblCompTitle.Left := 15;
  lblCompTitle.Top := 34;
  lblCompTitle.Font.Name := 'Segoe UI';
  lblCompTitle.Font.Style := [fsBold];
  lblCompTitle.AutoSize := True;
  lblCompTitle.Caption := 'Installation Components:';

  lblCompVal := TLabel.Create(WizardForm);
  lblCompVal.Parent := SummaryPanel;
  lblCompVal.Left := 30; 
  lblCompVal.Top := 48;
  lblCompVal.Font.Name := 'Segoe UI';
  lblCompVal.AutoSize := True;
  lblCompVal.WordWrap := False;

  lblReqArrow := TLabel.Create(WizardForm);
  lblReqArrow.Parent := SummaryPanel;
  lblReqArrow.Left := 0;
  lblReqArrow.Font.Name := 'Segoe UI';
  lblReqArrow.Font.Style := [fsBold];
  lblReqArrow.Font.Color := $648E75;
  lblReqArrow.Caption := '>';

  lblReqText := TLabel.Create(WizardForm);
  lblReqText.Parent := SummaryPanel;
  lblReqText.Left := 15;
  lblReqText.Font.Name := 'Segoe UI';
  lblReqText.AutoSize := True;

  lblAvailArrow := TLabel.Create(WizardForm);
  lblAvailArrow.Parent := SummaryPanel;
  lblAvailArrow.Left := 0;
  lblAvailArrow.Font.Name := 'Segoe UI';
  lblAvailArrow.Font.Style := [fsBold];
  lblAvailArrow.Font.Color := $648E75;
  lblAvailArrow.Caption := '>';

  lblAvailTitle := TLabel.Create(WizardForm);
  lblAvailTitle.Parent := SummaryPanel;
  lblAvailTitle.Left := 15;
  lblAvailTitle.Font.Name := 'Segoe UI';
  lblAvailTitle.Font.Style := [fsBold];
  lblAvailTitle.AutoSize := True;
  lblAvailTitle.Caption := 'Disk Space Available:';

  lblAvailVal := TLabel.Create(WizardForm);
  lblAvailVal.Parent := SummaryPanel;
  lblAvailVal.Font.Name := 'Segoe UI';
  lblAvailVal.AutoSize := True;
  // =========================================================================

  bg1 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\1.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg2 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\2.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg3 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\3.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg4 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\4.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  bg5 := ImgLoad(WizardForm.Handle, ExpandConstant('{tmp}\5.png'), 0, 0, WizardForm.ClientWidth, WizardForm.ClientHeight, True, True);
  
  hNextBtn := BtnCreate(WizardForm.Handle, 750, 435, 100, 35, ExpandConstant('{tmp}\btn_next.png'), 0, False);
  BtnSetEvent(hNextBtn, 1, CreateCallback(@NextBtnClick));
  
  // Custom Finish button (larger and right-aligned)
  hFinishBtn := BtnCreate(WizardForm.Handle, 690, 435, 160, 45, ExpandConstant('{tmp}\btn_finish.png'), 0, False);
  BtnSetEvent(hFinishBtn, 1, CreateCallback(@NextBtnClick));

  hInstallBtn := BtnCreate(WizardForm.Handle, 750, 435, 100, 35, ExpandConstant('{tmp}\btn_install.png'), 0, False);
  BtnSetEvent(hInstallBtn, 1, CreateCallback(@InstallBtnClick));

  hBackBtn := BtnCreate(WizardForm.Handle, 640, 435, 100, 35, ExpandConstant('{tmp}\btn_back_secondary.png'), 0, False);
  BtnSetEvent(hBackBtn, 1, CreateCallback(@BackBtnClick));

