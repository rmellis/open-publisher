          "innerHTML": "<div style='text-align: center; border-bottom: 2px solid #d4af37; padding-bottom: 30px;'><h1 style='font-family: \"Times New Roman\", serif; color: #d4af37; font-size: 36px; margin: 0; letter-spacing: 2px;'>ST. JUDE'S ACADEMY</h1><p style='color: #fff; font-family: sans-serif; font-size: 14px; letter-spacing: 4px; margin-top: 10px; text-transform: uppercase;'>Excellence Since 1884</p></div>",
